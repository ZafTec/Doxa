// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
  moduleFormat  = "cjs"

}

datasource db {
  provider = "postgresql"
}

model Item {
    id String @id @default(uuid())
    categoryId String
    brand String
    description String

    // Relations
    category Category @relation(fields: [categoryId], references: [id])
    itemVariants ItemVariant[]

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())
}

model Category {
    id String @id @default(uuid())
    name String
    items Item[]
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())
}

model ItemVariant {
    id String @id @default(uuid())
    itemId String
    color String
    stockQuantity Int
    price Int
    description String @default("Default Value")
    name String @default("Does not have a name")

    // Relations
    item Item @relation(fields:[itemId], references:[id])
    assets Asset[]
}

model Asset {
    id            String   @id @default(uuid())
    /// MinIO object key. Null for legacy externally-hosted assets that
    /// predate the S3 migration; always set for uploads going forward.
    key           String?  @unique
    url           String
    originalName  String?
    contentType   String?
    size          Int?
    etag          String?
    position      Int      @default(0)
    itemVariantId String
    createdAt     DateTime @default(now())

    itemVariant ItemVariant @relation(fields: [itemVariantId], references: [id], onDelete: Cascade)
}

enum AdminRole {
    SUPER_ADMIN
    EDITOR
}

model AdminUser {
    id String @id @default(uuid())
    email String @unique
    name String?
    role AdminRole @default(EDITOR)
    googleId String? @unique
    lastLoginAt DateTime?
    /// Seeded bootstrap admin - can never be role-changed or removed, so
    /// there's always at least one guaranteed way into the admin panel.
    isProtected Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())
}