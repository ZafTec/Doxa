# PostgreSQL database used by Prisma and the NestJS API.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doxa?schema=public"

# API port. The frontend development server uses port 3001.
PORT=3000

# Additional comma-separated browser origins allowed by CORS.
WEB_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"

# --- Admin auth (Google OAuth) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# and add GOOGLE_CALLBACK_URL as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Signs the admin session cookie. Generate with: openssl rand -hex 32
JWT_SECRET=
# How many days an admin session stays valid before re-auth via Google.
JWT_EXPIRES_IN_DAYS=7

# Where the API redirects back to after a Google login (the web app).
ADMIN_WEB_URL="http://localhost:3001"

# Email that gets seeded as the first SUPER_ADMIN by `bun run db:seed`.
# Must match the Google account you'll sign in with.
BOOTSTRAP_ADMIN_EMAIL=
