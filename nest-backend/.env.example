# PostgreSQL database used by Prisma and the NestJS API.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doxa?schema=public"

# API port. The frontend development server uses port 3001.
PORT=3000

# Additional comma-separated browser origins allowed by CORS.
WEB_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"

# --- Admin auth (Google OAuth) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# and add GOOGLE_CALLBACK_URL as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Signs the admin session cookie. Generate with: openssl rand -hex 32
JWT_SECRET=
# How many days an admin session stays valid before re-auth via Google.
JWT_EXPIRES_IN_DAYS=7

# Where the API redirects back to after a Google login (the web app).
ADMIN_WEB_URL="http://localhost:3001"

# Email that gets seeded as the first SUPER_ADMIN by `bun run db:seed`.
# Must match the Google account you'll sign in with.
BOOTSTRAP_ADMIN_EMAIL=

# --- Object storage (MinIO, S3-compatible) ---
# Restricted MinIO user scoped to the doxa-assets bucket - never the root user.
S3_ACCESS_KEY_ID=doxa-api
S3_SECRET_ACCESS_KEY=
S3_BUCKET=doxa-assets
S3_REGION=us-east-1

# Docker-network endpoint, used for API-to-MinIO operations (stat/delete).
S3_INTERNAL_ENDPOINT="http://minio:9000"
# Public endpoint, used only to sign browser-facing presigned URLs - a
# browser can't resolve the internal "minio" hostname.
S3_PUBLIC_ENDPOINT="https://storage.zaftech.co"
# Base URL assets are served from publicly (bucket is public-read).
ASSET_PUBLIC_BASE_URL="https://storage.zaftech.co/doxa-assets"
