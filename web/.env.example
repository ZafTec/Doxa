# Public URL of the NestJS API. Keep this on port 3000 for local development.
# Also used to build the admin Google sign-in link (${NEXT_PUBLIC_API_URL}/auth/google).
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Canonical public URL of this storefront. Used for metadataBase, canonical
# links, the sitemap, robots.txt, and Open Graph/Twitter image URLs - set
# this to the real production domain when deploying (no trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Optional until Cloudinary-backed product media is enabled.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
