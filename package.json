{
  "name": "doxa",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "nest-backend",
    "web"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "dev:api": "bun run --filter nest-backend dev",
    "dev:web": "bun run --filter web dev",
    "build": "bun run --parallel --filter '*' build",
    "lint": "bun run --parallel --filter '*' lint",
    "lint:fix": "bun run --parallel --filter '*' lint:fix",
    "test": "bun run --filter nest-backend test --runInBand",
    "test:e2e": "bun run --filter nest-backend test:e2e --runInBand",
    "check": "bun run lint && bun run test && bun run test:e2e && bun run build",
    "db:generate": "bun run --filter nest-backend db:generate",
    "db:migrate": "bun run --filter nest-backend db:migrate",
    "db:migrate:deploy": "bun run --filter nest-backend db:migrate:deploy",
    "db:seed": "bun run --filter nest-backend db:seed",
    "db:setup": "bun run --filter nest-backend db:setup",
    "db:studio": "bun run --filter nest-backend db:studio"
  }
}
